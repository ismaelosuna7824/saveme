# Copia este fichero a `.env` y rellénalo con la configuración de la app web de
# Firebase: Consola de Firebase → Configuración del proyecto → Tus apps → Web.
# Analytics tiene que estar activado en el proyecto (de ahí sale MEASUREMENT_ID).
# Son valores públicos: acaban en el JavaScript de la página. Sin ellos la landing
# funciona igual, solo que no manda eventos.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# URL pública donde se despliega, para canonical, hreflang y Open Graph.
SITE_URL=

# Opcional: un token de GitHub para que la consulta de la última Release al
# construir no choque con el límite de la API sin autenticar (60 por hora).
GITHUB_TOKEN=
