---
/** Iconos de una sola tinta (`currentColor`), en línea para no pedir nada más a la red. */
interface Props {
  name: 'apple' | 'windows' | 'linux' | 'github' | 'download' | 'arrow'
  class?: string
}

const { name, class: className } = Astro.props
---

